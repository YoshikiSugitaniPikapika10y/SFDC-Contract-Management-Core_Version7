<apex:page contentType="application/pdf; charset=UTF-8"
    renderAs="pdf"
    controller="EstimateDocumentPdfController"
    showHeader="false"
    applyhtmltag="false"
    language="ja"
    cache="true">

<html>
<head>
    <meta charset="UTF-8" />
    <style type="text/css">
        @page {
            size: A4;
            margin: 10mm;
        }
        html, body {
            margin: 0;
            padding: 0;
            font-family: "Arial Unicode MS", sans-serif;
            font-size: 10pt;
            color: #333;
            line-height: 1.4;
        }
        .page { width: 100%; }
        .title-row { text-align: center; margin-bottom: 10mm; }
        .title {
            font-size: 22pt;
            letter-spacing: 2px;
            font-weight: bold;
            color: #004d99;
            border-bottom: 3px solid #004d99;
            padding-bottom: 5px;
            display: inline-block;
        }
        .header { width: 100%; margin-bottom: 8mm; overflow: hidden; }
        .header::after { content: ""; display: block; clear: both; }
        .header-left { float: left; width: 55%; }
        .header-right { float: right; width: 42%; text-align: left; }
        .to-company {
            border-bottom: 2px solid #000;
            padding-bottom: 5px;
            margin-bottom: 8px;
            width: 100%;
            display: block;
        }
        .honorificleft { font-size: 14pt; font-weight: bold; margin-right: 10px; }
        .honorificright { font-size: 14pt; font-weight: bold; float: right; }
        .meta-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        .meta-table th, .meta-table td {
            padding: 3px 0;
            border-bottom: 1px solid #ccc;
            text-align: left;
            vertical-align: top;
            font-size: 9pt;
        }
        .meta-table th { width: 100px; font-weight: normal; color: #666; }
        .company-logo-table { width: 100%; border-collapse: collapse; margin-bottom: 5px; }
        .company-logo-table td { vertical-align: middle; padding: 0; }
        .company-logo { width: 80px; height: auto; }
        .company-name { font-size: 11pt; font-weight: bold; color: #004d99; margin: 0 0 2px 0; }
        .header-line { border-top: 1px solid #000; margin: 5px 0; clear: both; }
        .header-right p { margin: 0; font-size: 9pt; }
        .amount-block {
            margin: 15px 0 25px 0;
            padding: 8px;
            border: 2px solid #004d99;
            background-color: #e6f2ff;
            text-align: center;
        }
        .amount-label { font-weight: bold; font-size: 12pt; color: #004d99; margin-right: 20px; }
        .amount-value { font-weight: bold; font-size: 18pt; color: #000000; margin-right: 5px; }
        .amount-unit { font-weight: bold; font-size: 12pt; }
        .section { margin-bottom: 25px; }
        .section-title {
            font-size: 13pt;
            font-weight: bold;
            color: #004d99;
            border-left: 6px solid #004d99;
            padding-left: 10px;
            margin-bottom: 10px;
            line-height: 1.5;
            background-color: #f9f9f9;
            border-bottom: 1px solid #ddd;
            page-break-inside: avoid;
            page-break-after: avoid;
        }
        .section-total {
            float: right;
            font-size: 12pt;
            color: #333;
            font-weight: bold;
            margin-right: 5px;
        }
        .product-name-header {
            background-color: #ddd;
            font-weight: bold;
            font-size: 10pt;
            padding: 4px 8px;
            margin-top: 15px;
            border: 1px solid #000;
            border-bottom: none;
            color: #000;
            page-break-inside: avoid;
            page-break-after: avoid;
        }
        .line-item-table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
            border: 1px solid #000;
            margin-bottom: 5px;
        }
        .line-item-table th {
            background-color: #f2f2f2;
            color: #000;
            border: 1px solid #000;
            padding: 5px;
            font-size: 10pt;
            text-align: center;
            font-weight: bold;
        }
        .line-item-table td {
            border: 1px solid #000;
            padding: 6px 5px;
            font-size: 10pt;
            vertical-align: middle;
            word-wrap: break-word;
        }
        .line-item-table tr { page-break-inside: avoid; }
        .col-desc   { width: 35%; text-align: left; }
        .col-period { width: 25%; text-align: center; font-size: 9pt; }
        .col-unit   { width: 10%; text-align: center; }
        .col-qty    { width: 12%; text-align: right; }
        .col-amount { width: 18%; text-align: right; }
        .group-total-row { page-break-inside: avoid; }
        .group-total-row td {
            background-color: #fff;
            border-top: 1px solid #000;
            border-bottom: 1px solid #000;
            font-weight: bold;
        }
        .group-total-empty { border-right: 1px solid #000; }
        .group-total-label { text-align: center; border-right: none; }
        .group-total-amount { text-align: right; border-left: none; }
        .notes {
            margin-top: 30px;
            border-top: 1px solid #000;
            padding-top: 10px;
            page-break-inside: avoid;
        }
        .note-text { white-space: pre-wrap; }
    </style>
</head>

<body>
<apex:outputPanel layout="none" rendered="{!hasContext}">
<div class="page">

    <div class="title-row">
        <h1 class="title"><apex:outputText value="{!estimateSetting.EstimateTitle__c}" /></h1>
    </div>

    <div class="header">
        <div class="header-left">
            <div class="to-company">
                <span class="honorificleft">
                    <apex:outputText value="{!toCompanyNameDisplay}" />
                </span>
                <span class="honorificright">
                    <apex:outputText value="{!estimateSetting.HonorificTitle__c}" />
                </span>
                <div style="clear:both;"></div>
            </div>

            <p style="margin-bottom:10px;">
                <apex:outputText value="{!estimateSetting.EstimateSentence__c}" />
            </p>

            <table class="meta-table">
                <tr><th><apex:outputText value="{!estimateSetting.BasicTermPeriodLabel__c}"/></th><td><apex:outputText value="{!estimateSetting.BasicTermPeriod__c}"/></td></tr>
                <tr><th><apex:outputText value="{!estimateSetting.PaymentTerm__c}"/></th><td><apex:outputText value="{!estimateSetting.PaymentTermSentence__c}"/></td></tr>
                <tr><th><apex:outputText value="{!estimateSetting.TermFeeStartDate__c}"/></th><td><apex:outputText value="{!termFeeStartDateDisplay}"/></td></tr>
                <tr><th><apex:outputText value="{!estimateSetting.TermDueDate__c}"/></th><td><apex:outputText value="{!estimateSetting.EstimateDueDateSentence__c}"/></td></tr>
            </table>
        </div>

        <div class="header-right">
            <table class="company-logo-table">
                <tr>
                    <td><img src="{!URLFOR($Resource.UZEROLOGO)}" alt="Logo" class="company-logo"/></td>
                    <td>
                        <p class="company-name"><apex:outputText value="{!estimateSetting.CompanyName__c}"/></p>
                        <p>No : <apex:outputText value="{!estimateNumber}"/></p>
                        <p>Date : <apex:outputText value="{!estimateDateDisplay}"/></p>
                    </td>
                </tr>
            </table>
            <div class="header-line"></div>
            <p><apex:outputText value="{!estimateSetting.PostalNumber__c}"/></p>
            <p><apex:outputText value="{!estimateSetting.AdressFirstHalf__c}"/></p>
            <p><apex:outputText value="{!estimateSetting.AddressLastHalf__c}"/></p>
            <p><apex:outputText value="{!estimateSetting.TELLabel__c}" /> <apex:outputText value="{!estimateSetting.TELValue__c}"/> </p>
            <p><apex:outputText value="{!estimateSetting.FAXLabel__c}" /> <apex:outputText value="{!estimateSetting.FAXSentence__c}"/> </p>
            <p><apex:outputText value="{!estimateSetting.OwnerLabel__c}" /><apex:outputText value="{!ownerNameDisplay}"/></p>
        </div>
    </div>

    <div class="amount-block">
        <span class="amount-label"><apex:outputText value="{!estimateSetting.EstimateSumLabel__c}"/></span>
        <span class="amount-value">
            <apex:outputText value="{0, number, ###,###,###,###}">
                <apex:param value="{!totalAmount}" />
            </apex:outputText>
        </span>
        <span class="amount-unit"><apex:outputText value="{!estimateSetting.UnitSentence__c}"/></span>
    </div>

    <apex:outputPanel rendered="{!NOT(digitalGroups.empty)}">
    <div class="section">
        <h2 class="section-title">
            <apex:outputText value="{!estimateSetting.DigitalLicenceFeeLabel__c}"/>
            <span class="section-total">
                合計:
                <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!digitalTotalIncTax}"/></apex:outputText>
                <apex:outputText value="{!estimateSetting.UnitSentence__c}"/>
            </span>
        </h2>

        <apex:repeat value="{!digitalGroups}" var="group">
            <div class="product-name-header">
                <apex:outputText value="{!group.productName}"/>
            </div>

            <table class="line-item-table">
                <thead>
                    <tr>
                        <th class="col-desc">内訳</th>
                        <th class="col-period">提供期間</th>
                        <th class="col-unit">単位</th>
                        <th class="col-qty">数量</th>
                        <th class="col-amount">金額</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!group.items}" var="item">
                        <tr style="page-break-inside: avoid;">
                            <td class="col-desc"><apex:outputText value="{!item.breakdown}"/></td>
                            <td class="col-period"><apex:outputText value="{!item.period}"/></td>
                            <td class="col-unit"><apex:outputText value="{!item.unit}"/></td>
                            <td class="col-qty">
                                <apex:outputText value="{0, number, ###,##0.##}"><apex:param value="{!item.quantity}" /></apex:outputText>
                            </td>
                            <td class="col-amount">
                                <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!item.amount}" /></apex:outputText>
                            </td>
                        </tr>
                    </apex:repeat>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">小計</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.groupTotal}" /></apex:outputText>
                        </td>
                    </tr>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">税額</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.taxAmount}" /></apex:outputText>
                        </td>
                    </tr>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">合計</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.totalAmountIncTax}" /></apex:outputText>
                        </td>
                    </tr>
                </tbody>
            </table>
        </apex:repeat>
    </div>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!NOT(consultingGroups.empty)}">
    <div class="section">
        <h2 class="section-title">
            <apex:outputText value="{!estimateSetting.ConsultingFeeLabel__c}"/>
            <span class="section-total">
                合計:
                <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!consultingTotalIncTax}"/></apex:outputText>
                <apex:outputText value="{!estimateSetting.UnitSentence__c}"/>
            </span>
        </h2>

        <apex:repeat value="{!consultingGroups}" var="group">
            <div class="product-name-header"><apex:outputText value="{!group.productName}"/></div>
            <table class="line-item-table">
                <thead>
                    <tr>
                        <th class="col-desc">内訳</th>
                        <th class="col-period">提供期間</th>
                        <th class="col-unit">単位</th>
                        <th class="col-qty">数量</th>
                        <th class="col-amount">金額</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!group.items}" var="item">
                        <tr style="page-break-inside: avoid;">
                            <td class="col-desc"><apex:outputText value="{!item.breakdown}"/></td>
                            <td class="col-period"><apex:outputText value="{!item.period}"/></td>
                            <td class="col-unit"><apex:outputText value="{!item.unit}"/></td>
                            <td class="col-qty"><apex:outputText value="{0, number, ###,##0.##}"><apex:param value="{!item.quantity}" /></apex:outputText></td>
                            <td class="col-amount"><apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!item.amount}" /></apex:outputText></td>
                        </tr>
                    </apex:repeat>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">小計</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.groupTotal}" /></apex:outputText>
                        </td>
                    </tr>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">税額</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.taxAmount}" /></apex:outputText>
                        </td>
                    </tr>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">合計</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.totalAmountIncTax}" /></apex:outputText>
                        </td>
                    </tr>
                </tbody>
            </table>
        </apex:repeat>
    </div>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!NOT(trainingGroups.empty)}">
    <div class="section">
        <h2 class="section-title">
            <apex:outputText value="{!estimateSetting.FeedbackCoacingFeeLabel__c}"/>
            <span class="section-total">
                合計:
                <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!trainingTotalIncTax}"/></apex:outputText>
                <apex:outputText value="{!estimateSetting.UnitSentence__c}"/>
            </span>
        </h2>

        <apex:repeat value="{!trainingGroups}" var="group">
            <div class="product-name-header"><apex:outputText value="{!group.productName}"/></div>
            <table class="line-item-table">
                <thead>
                    <tr>
                        <th class="col-desc">内訳</th>
                        <th class="col-period">提供期間</th>
                        <th class="col-unit">単位</th>
                        <th class="col-qty">数量</th>
                        <th class="col-amount">金額</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!group.items}" var="item">
                        <tr style="page-break-inside: avoid;">
                            <td class="col-desc"><apex:outputText value="{!item.breakdown}"/></td>
                            <td class="col-period"><apex:outputText value="{!item.period}"/></td>
                            <td class="col-unit"><apex:outputText value="{!item.unit}"/></td>
                            <td class="col-qty"><apex:outputText value="{0, number, ###,##0.##}"><apex:param value="{!item.quantity}" /></apex:outputText></td>
                            <td class="col-amount"><apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!item.amount}" /></apex:outputText></td>
                        </tr>
                    </apex:repeat>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">小計</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.groupTotal}" /></apex:outputText>
                        </td>
                    </tr>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">税額</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.taxAmount}" /></apex:outputText>
                        </td>
                    </tr>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">合計</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.totalAmountIncTax}" /></apex:outputText>
                        </td>
                    </tr>
                </tbody>
            </table>
        </apex:repeat>
    </div>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!NOT(otherGroups.empty)}">
    <div class="section">
        <h2 class="section-title">
            <apex:outputText value="{!estimateSetting.OtherFeeLavel__c}"/>
            <span class="section-total">
                合計:
                <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!otherTotalIncTax}"/></apex:outputText>
                <apex:outputText value="{!estimateSetting.UnitSentence__c}"/>
            </span>
        </h2>
        <apex:repeat value="{!otherGroups}" var="group">
            <div class="product-name-header"><apex:outputText value="{!group.productName}"/></div>
            <table class="line-item-table">
                <thead>
                    <tr>
                        <th class="col-desc">内訳</th>
                        <th class="col-period">提供期間</th>
                        <th class="col-unit">単位</th>
                        <th class="col-qty">数量</th>
                        <th class="col-amount">金額</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!group.items}" var="item">
                        <tr style="page-break-inside: avoid;">
                            <td class="col-desc"><apex:outputText value="{!item.breakdown}"/></td>
                            <td class="col-period"><apex:outputText value="{!item.period}"/></td>
                            <td class="col-unit"><apex:outputText value="{!item.unit}"/></td>
                            <td class="col-qty"><apex:outputText value="{0, number, ###,##0.##}"><apex:param value="{!item.quantity}" /></apex:outputText></td>
                            <td class="col-amount"><apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!item.amount}" /></apex:outputText></td>
                        </tr>
                    </apex:repeat>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">小計</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.groupTotal}" /></apex:outputText>
                        </td>
                    </tr>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">税額</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.taxAmount}" /></apex:outputText>
                        </td>
                    </tr>
                    <tr class="group-total-row" style="page-break-inside: avoid;">
                        <td colspan="3" class="group-total-empty"></td>
                        <td class="group-total-label">合計</td>
                        <td class="group-total-amount">
                            <apex:outputText value="{0, number, ###,###,###}"><apex:param value="{!group.totalAmountIncTax}" /></apex:outputText>
                        </td>
                    </tr>
                </tbody>
            </table>
        </apex:repeat>
    </div>
    </apex:outputPanel>

    <div class="notes">
        <p style="font-weight:bold; margin-bottom:5px;">
            <apex:outputText value="{!estimateSetting.NoteSentenceLabel__c}"/>
        </p>
        <div style="width: 100%; word-wrap: break-word; word-break: break-all;">
            <apex:outputText value="{!SUBSTITUTE(SUBSTITUTE(estimateSetting.NoteSencente__c, '\r\n', '<br/>'), '\n', '<br/>')}" escape="false"/>
        </div>
    </div>

</div>
</apex:outputPanel>
</body>
</html>
</apex:page>
