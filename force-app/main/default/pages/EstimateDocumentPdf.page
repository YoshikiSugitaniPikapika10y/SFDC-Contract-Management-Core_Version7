<apex:page
  controller="EstimateDocumentPdfController"
  renderAs="pdf"
  contentType="application/pdf; charset=UTF-8"
  showHeader="false"
  applyHtmlTag="false"
  language="ja"
  cache="false"
>
  <!-- 仕様: Core 第4.8節・第11.3.1節。登録番号と Note__c を出す。振込先とプライバシーポリシーURLは出さない。ロゴと角印は同梱しない。パッケージ項目だけ。 -->
  <html>
    <head>
      <meta charset="UTF-8" />
      <style type="text/css">
        @page { size: A4; margin: 10mm 15mm 10mm 15mm; }
        * { font-family: "Arial Unicode MS", sans-serif; }
        html, body { margin: 0; padding: 0; font-family: "Arial Unicode MS", sans-serif; font-size: 12px; }
        p { margin: 0; }
        .title { font-size: 22px; text-align: center; margin: 2mm 0 4mm 0; }
        .head { width: 100%; border-collapse: collapse; table-layout: fixed; }
        .head td { vertical-align: top; padding: 0; }
        .addressee { font-size: 16px; line-height: 140%; }
        .meta { font-size: 12px; line-height: 160%; }
        .issuer { font-size: 12px; line-height: 150%; }
        .notice { font-size: 11px; white-space: pre-line; }
        .sentence { font-size: 12px; margin: 3mm 0; }
        .amount { font-size: 18px; font-weight: bold; margin: 2mm 0 4mm 0; }
        .amount table { border-collapse: collapse; }
        .amount th { font-weight: normal; border: 1px solid #000; padding: 2px 8px; background-color: #d3d3d3; }
        .amount td { border: 1px solid #000; padding: 2px 8px; text-align: right; font-size: 18px; }
        .detail { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 10px; }
        .detail th { font-weight: normal; border: 1px solid #000; padding: 2px 6px; background-color: #d3d3d3; text-align: center; }
        .detail td { border: 1px solid #000; padding: 2px 6px; height: 14px; }
        .clip { overflow: hidden; white-space: nowrap; }
        .summary { width: 220px; border-collapse: collapse; font-size: 12px; margin-top: 2mm; margin-left: auto; page-break-inside: avoid; }
        .summary th { font-weight: normal; border: 1px solid #000; padding: 2px 6px; background-color: #d3d3d3; text-align: center; width: 40%; }
        .summary td { border: 1px solid #000; padding: 2px 6px; text-align: right; }
        .note { width: 100%; border-collapse: collapse; border: 1px solid #000; margin-top: 5mm; page-break-inside: avoid; }
        .note th { font-weight: normal; border: 1px solid #000; padding: 2px 6px; background-color: #d3d3d3; text-align: left; }
        .note td { border: 1px solid #000; height: 28mm; padding: 5px; font-size: 12px; vertical-align: top; white-space: pre-line; word-wrap: break-word; }
        .left { text-align: left; }
        .center { text-align: center; }
        .right { text-align: right; }
        .bold { font-weight: bold; }
      </style>
    </head>
    <body>
      <apex:outputPanel rendered="{!hasContext}">
        <table class="head">
          <tr>
            <td style="width: 70%;"></td>
            <td style="width: 30%;" class="right">
              <p class="meta">発行日　<apex:outputText value="{!documentContext.issueDatePrint}" /></p>
            </td>
          </tr>
        </table>

        <p class="title">御見積書</p>

        <table class="head">
          <tr>
            <td style="width: 60%;">
              <p class="addressee">
                <apex:outputText value="{!documentText.toCompanyName}" />
                <apex:outputPanel rendered="{!NOT(ISBLANK(documentText.honorificTitle))}">
                  &#160;&#160;<apex:outputText value="{!documentText.honorificTitle}" />
                </apex:outputPanel>
              </p>
              <p class="sentence"><apex:outputText value="{!documentText.estimateSentence}" /></p>
              <div class="amount">
                <table>
                  <tr>
                    <th>合計金額</th>
                    <td>
                      &#165;<apex:outputText value="{0, number, ###,###,###,##0}" rendered="{!NOT(ISBLANK(documentContext.lineTotalInclTax))}">
                        <apex:param value="{!documentContext.lineTotalInclTax}" />
                      </apex:outputText>
                    </td>
                  </tr>
                </table>
              </div>
              <p class="meta">有効期限　<apex:outputText value="{!documentContext.validDatePrint}" /></p>
              <apex:outputPanel rendered="{!NOT(ISBLANK(documentText.documentFooter))}">
                <p class="notice"><apex:outputText value="{!documentText.documentFooter}" /></p>
              </apex:outputPanel>
            </td>
            <td style="width: 40%;">
              <p class="issuer bold"><apex:outputText value="{!documentContext.companyName}" /></p>
              <p class="issuer notice"><apex:outputText value="{!documentContext.companyAddressLine1}" /></p>
              <p class="issuer">登録番号　<apex:outputText value="{!documentText.registrationNumber}" /></p>
            </td>
          </tr>
        </table>

        <table class="detail">
          <tr>
            <th style="width: 38%;">内容</th>
            <th style="width: 22%;">有料期間</th>
            <th style="width: 8%;">数量</th>
            <th style="width: 8%;">単位</th>
            <th style="width: 12%;">単価（税抜）</th>
            <th style="width: 12%;">金額（税抜）</th>
          </tr>
          <apex:repeat value="{!documentLines}" var="line">
            <tr>
              <td class="left clip"><apex:outputText value="{!line.content}" />&#160;</td>
              <td class="center clip"><apex:outputText value="{!line.period}" /></td>
              <td class="right clip">
                <apex:outputText value="{0, number, ###,##0.##}">
                  <apex:param value="{!line.quantity}" />
                </apex:outputText>
              </td>
              <td class="center clip"><apex:outputText value="{!line.unit}" /></td>
              <td class="right clip">
                <apex:outputText value="{0, number, ###,###,##0.##}">
                  <apex:param value="{!line.unitPrice}" />
                </apex:outputText>
              </td>
              <td class="right clip">
                <apex:outputText value="{0, number, ###,###,##0}">
                  <apex:param value="{!line.amount}" />
                </apex:outputText>
              </td>
            </tr>
          </apex:repeat>
        </table>

        <table class="summary">
          <tr>
            <th>小計</th>
            <td>
              <apex:outputText value="{0, number, ###,###,###,##0}" rendered="{!NOT(ISBLANK(documentContext.lineTotal))}">
                <apex:param value="{!documentContext.lineTotal}" />
              </apex:outputText>
            </td>
          </tr>
          <tr>
            <th>
              消費税
              <apex:outputPanel rendered="{!NOT(ISBLANK(documentContext.taxPercentLabel))}">
                （<apex:outputText value="{!documentContext.taxPercentLabel}" />%）
              </apex:outputPanel>
            </th>
            <td>
              <apex:outputText value="{0, number, ###,###,###,##0}" rendered="{!NOT(ISBLANK(documentContext.taxAmount))}">
                <apex:param value="{!documentContext.taxAmount}" />
              </apex:outputText>
            </td>
          </tr>
          <tr>
            <th class="bold">合計</th>
            <td class="bold">
              <apex:outputText value="{0, number, ###,###,###,##0}" rendered="{!NOT(ISBLANK(documentContext.lineTotalInclTax))}">
                <apex:param value="{!documentContext.lineTotalInclTax}" />
              </apex:outputText>
            </td>
          </tr>
        </table>

        <table class="note">
          <tr><th>備考</th></tr>
          <tr><td><apex:outputText value="{!documentText.noteSentence}" /></td></tr>
        </table>
      </apex:outputPanel>
    </body>
  </html>
</apex:page>
