<apex:page
  controller="EstimateDocumentPdfController"
  showHeader="false"
  sidebar="false"
  standardStylesheets="true"
  docType="html-5.0"
  lightningStylesheets="false"
>
  <!-- 仕様: Core 第4.8節・第7.10節・第11.3.2節。PDFエンジンは SLDS を読まない。 -->
  <style type="text/css">
    .estimateIssueTemplate {
      min-width: 24rem;
      width: 100%;
    }
  </style>
  <apex:form>
    <apex:outputPanel id="issuePanel">
      <apex:pageBlock title="見積書発行">
        <apex:pageMessages />
        <apex:pageBlockSection
          columns="1"
          rendered="{!AND(hasContext, NOT(issueSucceeded))}"
        >
          <apex:pageBlockSectionItem>
            <apex:outputLabel value="帳票" for="documentTemplate" />
            <apex:selectList
              id="documentTemplate"
              styleClass="estimateIssueTemplate"
              value="{!selectedTemplateKey}"
              size="1"
              required="false"
            >
              <apex:selectOptions value="{!templateOptions}" />
              <apex:actionSupport
                event="onchange"
                action="{!refreshIssueFileName}"
                rerender="issueFileNamePanel"
              />
            </apex:selectList>
          </apex:pageBlockSectionItem>
          <apex:pageBlockSectionItem>
            <apex:outputLabel value="ファイル名" for="issueFileName" />
            <apex:outputPanel id="issueFileNamePanel">
              <apex:outputText id="issueFileName" value="{!issueFileName}" />
            </apex:outputPanel>
          </apex:pageBlockSectionItem>
        </apex:pageBlockSection>
        <!-- 仕様: Core 第4.8節・第7.10節。getContentAsPDF は Ajax rerender 中に呼ばない。請求の LWC→Apex 発行と同じく同期フルポスト。 -->
        <apex:pageBlockButtons
          location="bottom"
          rendered="{!AND(hasContext, NOT(issueSucceeded), canIssuePdf)}"
        >
          <apex:actionStatus id="issueStatus">
            <apex:facet name="start">
              <apex:outputText value="発行中…" />
            </apex:facet>
            <apex:facet name="stop">
              <apex:commandButton
                value="発行する"
                action="{!issuePdf}"
                status="issueStatus"
              />
            </apex:facet>
          </apex:actionStatus>
        </apex:pageBlockButtons>
        <apex:outputPanel rendered="{!issueSucceeded}">
          <span id="issuedPreviewDocumentId" style="display: none"
            >{!issuedContentDocumentId}</span
          >
          <p>
            <button type="button" onclick="openIssuedPreviewIfAny()">
              発行したファイルをプレビュー
            </button>
          </p>
          <apex:outputPanel rendered="{!showSendThisFile}">
            <button
              type="button"
              onclick="openSendThisFile()"
            >
              このファイルを送る
            </button>
          </apex:outputPanel>
        </apex:outputPanel>
      </apex:pageBlock>
    </apex:outputPanel>
  </apex:form>
  <script>
    // 仕様: Core 第4.8節・第7.10節・第4.3.1節。発行面に留まる。プレビューと送付はページを移さず、同じ発行画面へ渡す。
    function issuedDocumentId() {
      var el = document.getElementById("issuedPreviewDocumentId");
      return el
        ? String(el.textContent || "").replace(/^\s+|\s+$/g, "")
        : "";
    }
    function postIssueAction(action) {
      var documentId = issuedDocumentId();
      if (!documentId || !window.parent || window.parent === window) {
        return;
      }
      window.parent.postMessage(
        {
          source: "cmc-estimate-issue",
          action: action,
          contentDocumentId: documentId
        },
        window.location.origin
      );
    }
    function openIssuedPreviewIfAny() {
      postIssueAction("preview");
    }
    function openSendThisFile() {
      postIssueAction("send");
    }
  </script>
</apex:page>
