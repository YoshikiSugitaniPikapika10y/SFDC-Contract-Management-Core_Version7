<apex:page
  controller="InvoiceDocumentPdfController"
  renderAs="pdf"
  contentType="application/pdf; charset=UTF-8"
  showHeader="false"
  applyHtmlTag="false"
  language="ja"
  cache="false"
>
  <!-- 仕様: Core 第7.1節・第11.3.1節。備考位置は Memo__c。登録番号と振込先を出す。プライバシーポリシーURLは出さない。ロゴと角印は同梱しない。パッケージ項目だけ。宛名の御中は変えない。 -->
  <html>
    <head>
      <meta charset="UTF-8" />
      <style type="text/css">
        @page { size: A4; margin: 10mm 15mm 10mm 15mm; }
        * { font-family: "Arial Unicode MS", sans-serif; }
        html, body { margin: 0; padding: 0; font-family: "Arial Unicode MS", sans-serif; font-size: 12px; }
        p { margin: 0; }
        .title { font-size: 22px; text-align: center; margin: 2mm 0 4mm 0; }
        .head { width: 100%; border-collapse: collapse; table-layout: fixed; }
        .head td { vertical-align: top; padding: 0; }
        .addressee { font-size: 16px; line-height: 140%; white-space: pre-line; }
        .meta { font-size: 12px; line-height: 160%; }
        .issuer { font-size: 12px; line-height: 150%; white-space: pre-line; }
        .notice { font-size: 11px; white-space: pre-line; }
        .amount { font-size: 22px; font-weight: bold; text-decoration: underline; margin: 4mm 0 4mm 0; }
        .detail { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 10px; }
        .detail th { font-weight: normal; border: 1px solid #000; padding: 2px 6px; background-color: #d3d3d3; text-align: center; }
        .detail td { border: 1px solid #000; padding: 2px 6px; height: 14px; }
        .clip { overflow: hidden; white-space: nowrap; }
        .summary { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 12px; margin-top: 4mm; page-break-inside: avoid; }
        .summary th { font-weight: normal; border: 1px solid #000; padding: 2px 6px; background-color: #d3d3d3; text-align: center; }
        .summary td.val { border: 1px solid #000; padding: 2px 6px; text-align: right; }
        .summary td.pay { vertical-align: top; padding: 2px 6px; }
        .pay td { padding: 1px 6px 1px 0; font-size: 12px; vertical-align: top; }
        .small { font-size: 10px; }
        .bold { font-weight: bold; }
        .note { width: 100%; border-collapse: collapse; border: 1px solid #000; margin-top: 5mm; page-break-inside: avoid; }
        .note td { border: 1px solid #000; height: 40mm; padding: 5px; font-size: 12px; vertical-align: top; white-space: pre-line; word-wrap: break-word; }
        .left { text-align: left; }
        .center { text-align: center; }
        .right { text-align: right; }
      </style>
    </head>
    <body>
      <apex:outputPanel rendered="{!hasContext}">
        <p class="title">請求書</p>

        <table class="head">
          <tr>
            <td style="width: 65%;">
              <p class="addressee"><apex:outputText value="{!context.addressee}" /></p>
            </td>
            <td style="width: 15%;">
              <p class="meta">請求日</p>
              <p class="meta">請求書番号</p>
              <p class="meta">登録番号</p>
            </td>
            <td style="width: 20%;" class="right">
              <p class="meta"><apex:outputText value="{!context.invoiceDatePrint}" /></p>
              <p class="meta"><apex:outputText value="{!context.invoice.Name}" /></p>
              <p class="meta"><apex:outputText value="{!context.documentSetting.InvoiceRegistrationNumber__c}" /></p>
            </td>
          </tr>
        </table>

        <table class="head" style="margin-top: 6mm;">
          <tr>
            <td style="width: 55%; vertical-align: bottom;">
              <apex:outputPanel rendered="{!NOT(ISBLANK(context.documentSetting.DocumentFooter__c))}">
                <p class="notice"><apex:outputText value="{!context.documentSetting.DocumentFooter__c}" /></p>
              </apex:outputPanel>
            </td>
            <td style="width: 45%;" class="right">
              <p class="issuer bold"><apex:outputText value="{!context.documentSetting.CompanyName__c}" /></p>
              <p class="issuer"><apex:outputText value="{!context.documentSetting.Address__c}" /></p>
            </td>
          </tr>
        </table>

        <p class="amount">
          ご請求金額&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;
          &#165;<apex:outputText value="{0, number, ###,###,###,##0}">
            <apex:param value="{!context.amountIncludingTax}" />
          </apex:outputText>
        </p>

        <table class="detail">
          <tr>
            <th style="width: 37%;">内容</th>
            <th style="width: 23%;">有料期間</th>
            <th style="width: 7%;">数量</th>
            <th style="width: 8%;">単位</th>
            <th style="width: 12.5%;">単価（税抜）</th>
            <th style="width: 12.5%;">金額（税抜）</th>
          </tr>
          <apex:repeat value="{!context.linePrints}" var="line">
            <tr>
              <td class="left"><apex:outputText value="{!line.content}" />&#160;</td>
              <td class="center clip"><apex:outputText value="{!line.period}" /></td>
              <td class="right clip">
                <apex:outputText value="{0, number, ###,##0.##}">
                  <apex:param value="{!line.quantity}" />
                </apex:outputText>
              </td>
              <td class="center clip"><apex:outputText value="{!line.unit}" /></td>
              <td class="right clip">
                <!-- 仕様: Core 第7.1節・第7.10節・第11.9節。単価は保存した小数第2位まで印字する。整数はそのまま。 -->
                <apex:outputText value="{0, number, ###,###,##0.##}">
                  <apex:param value="{!line.unitPrice}" />
                </apex:outputText>
              </td>
              <td class="right clip">
                <apex:outputText value="{0, number, ###,###,##0}">
                  <apex:param value="{!line.amount}" />
                </apex:outputText>
              </td>
            </tr>
          </apex:repeat>
        </table>

        <table class="summary">
          <tr>
            <td class="pay" rowspan="4" style="width: 52%;">
              <table class="pay">
                <tr>
                  <td>入金期日</td>
                  <td><apex:outputText value="{!context.paymentDueDatePrint}" /></td>
                </tr>
                <tr>
                  <td>振込先</td>
                  <td class="notice"><apex:outputText value="{!context.documentSetting.BankTransferInfo__c}" /></td>
                </tr>
              </table>
            </td>
            <th style="width: 24%;">小計</th>
            <td class="val" style="width: 24%;">
              <apex:outputText value="{0, number, ###,###,###,##0}">
                <apex:param value="{!context.amountExcludingTax}" />
              </apex:outputText>
            </td>
          </tr>
          <tr>
            <th>消費税</th>
            <td class="val">
              <apex:outputText value="{0, number, ###,###,###,##0}">
                <apex:param value="{!context.taxAmount}" />
              </apex:outputText>
            </td>
          </tr>
          <tr>
            <th class="bold">合計</th>
            <td class="val bold">
              <apex:outputText value="{0, number, ###,###,###,##0}">
                <apex:param value="{!context.amountIncludingTax}" />
              </apex:outputText>
            </td>
          </tr>
          <tr>
            <th>
              内訳&#160;&#160;&#160;<apex:outputText value="{!IF(ISBLANK(context.taxBaseLabel), '対象(税抜)', context.taxBaseLabel)}" />
              <br />
              <span class="small">
                <apex:outputText value="{!IF(ISBLANK(context.taxRateLabel), '消費税', context.taxRateLabel)}" />
              </span>
            </th>
            <td class="val">
              <apex:outputText value="{0, number, ###,###,###,##0}">
                <apex:param value="{!context.amountExcludingTax}" />
              </apex:outputText>
              <br />
              <span class="small">
                <apex:outputText value="{0, number, ###,###,###,##0}">
                  <apex:param value="{!context.taxAmount}" />
                </apex:outputText>
              </span>
            </td>
          </tr>
        </table>

        <table class="note">
          <tr>
            <td>
              [備考]<br />
              <apex:outputText value="{!context.invoice.Memo__c}" />
            </td>
          </tr>
        </table>
      </apex:outputPanel>
    </body>
  </html>
</apex:page>
