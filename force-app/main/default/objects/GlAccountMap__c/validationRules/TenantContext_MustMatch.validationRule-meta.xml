<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TenantContext_MustMatch</fullName>
    <active>true</active>
    <description>仕様: Accounting 第6.2節。テナント条件セットと評価コンテキストを一致させる。</description>
    <errorConditionFormula>AND(
        ISPICKVAL(ConditionSourceType__c, "Tenant"),
        NOT(ISBLANK(TenantConditionSet__c)),
        TEXT(EvaluationContext__c) &lt;&gt; TEXT(TenantConditionSet__r.EvaluationContext__c)
    )</errorConditionFormula>
    <errorMessage>テナント条件セットの評価コンテキストが割当と一致しません。</errorMessage>
</ValidationRule>
