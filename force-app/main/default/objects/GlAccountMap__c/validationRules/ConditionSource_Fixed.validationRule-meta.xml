<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ConditionSource_Fixed</fullName>
    <active>true</active>
    <description>仕様: Accounting 第6.2節。固定では固定条件セットキーだけを必須とする。</description>
    <errorConditionFormula>AND(
        ISPICKVAL(ConditionSourceType__c, "Fixed"),
        OR(
            ISBLANK(TEXT(FixedConditionSetKey__c)),
            NOT(ISBLANK(TenantConditionSet__c))
        )
    )</errorConditionFormula>
    <errorMessage>条件種別が固定のときは、固定条件セットキーだけを指定してください。</errorMessage>
</ValidationRule>
