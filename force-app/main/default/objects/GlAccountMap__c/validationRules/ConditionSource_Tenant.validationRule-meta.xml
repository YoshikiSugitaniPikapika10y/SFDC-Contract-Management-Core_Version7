<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ConditionSource_Tenant</fullName>
    <active>true</active>
    <description>仕様: Accounting 第6.2節。テナントではテナント条件セットだけを必須とする。</description>
    <errorConditionFormula>AND(
        ISPICKVAL(ConditionSourceType__c, "Tenant"),
        OR(
            ISBLANK(TenantConditionSet__c),
            NOT(ISBLANK(TEXT(FixedConditionSetKey__c)))
        )
    )</errorConditionFormula>
    <errorMessage>条件種別がテナントのときは、テナント条件セットだけを指定してください。</errorMessage>
</ValidationRule>
