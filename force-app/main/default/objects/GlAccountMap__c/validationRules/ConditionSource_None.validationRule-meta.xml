<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ConditionSource_None</fullName>
    <active>true</active>
    <description>仕様: Accounting 第6.2節。なしでは条件2項目を空にする。</description>
    <errorConditionFormula>AND(
        ISPICKVAL(ConditionSourceType__c, "None"),
        OR(
            NOT(ISBLANK(TEXT(FixedConditionSetKey__c))),
            NOT(ISBLANK(TenantConditionSet__c))
        )
    )</errorConditionFormula>
    <errorMessage>条件種別がなしのときは、固定条件セットキーとテナント条件セットを空にしてください。</errorMessage>
</ValidationRule>
