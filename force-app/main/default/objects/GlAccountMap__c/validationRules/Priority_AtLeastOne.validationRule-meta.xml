<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Priority_AtLeastOne</fullName>
    <active>true</active>
    <description>仕様: Accounting 第6.2節。優先度は1以上。</description>
    <errorConditionFormula>OR(ISBLANK(Priority__c), Priority__c &lt; 1)</errorConditionFormula>
    <errorDisplayField>Priority__c</errorDisplayField>
    <errorMessage>優先度は1以上にしてください。</errorMessage>
</ValidationRule>
