<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Equity_Forbidden</fullName>
    <active>true</active>
    <description>仕様: Accounting 第10.2節。純資産科目は手動仕訳設定で使用できない。</description>
    <errorConditionFormula>OR(
        ISPICKVAL(DebitAccount__r.AccountType__c, "Equity"),
        ISPICKVAL(CreditAccount__r.AccountType__c, "Equity")
    )</errorConditionFormula>
    <errorDisplayField>DebitAccount__c</errorDisplayField>
    <errorMessage>純資産科目は手動仕訳設定で使用できません。</errorMessage>
</ValidationRule>
