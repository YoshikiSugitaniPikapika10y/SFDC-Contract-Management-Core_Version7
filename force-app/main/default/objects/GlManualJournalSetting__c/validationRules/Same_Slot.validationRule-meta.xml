<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Same_Slot</fullName>
    <active>true</active>
    <description>仕様: Accounting 第10.2節。借方と貸方に同じスロットを指定しない。</description>
    <errorConditionFormula>AND(
        NOT(ISBLANK(TEXT(DebitSlotKey__c))),
        TEXT(DebitSlotKey__c) = TEXT(CreditSlotKey__c)
    )</errorConditionFormula>
    <errorDisplayField>CreditSlotKey__c</errorDisplayField>
    <errorMessage>借方と貸方に同じスロットは指定できません。</errorMessage>
</ValidationRule>
