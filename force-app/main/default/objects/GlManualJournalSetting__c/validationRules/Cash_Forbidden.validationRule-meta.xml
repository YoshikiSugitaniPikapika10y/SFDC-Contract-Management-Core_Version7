<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cash_Forbidden</fullName>
    <active>true</active>
    <description>仕様: Accounting 第10.2節、第10.1節。借方・貸方のいずれにもCASHを指定しない。</description>
    <errorConditionFormula>OR(
        ISPICKVAL(DebitSlotKey__c, "Cash"),
        ISPICKVAL(CreditSlotKey__c, "Cash")
    )</errorConditionFormula>
    <errorDisplayField>DebitSlotKey__c</errorDisplayField>
    <errorMessage>借方・貸方のいずれにも現金・預金は指定できません。現預金が動く場合は請求入出金を使ってください。</errorMessage>
</ValidationRule>
