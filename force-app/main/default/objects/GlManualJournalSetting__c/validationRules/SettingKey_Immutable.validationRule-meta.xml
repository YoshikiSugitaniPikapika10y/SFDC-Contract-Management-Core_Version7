<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SettingKey_Immutable</fullName>
    <active>true</active>
    <description>仕様: Accounting 第10.2節。シードキーは作成後変更不可。</description>
    <errorConditionFormula>AND(
        NOT(ISNEW()),
        ISCHANGED(SettingKey__c)
    )</errorConditionFormula>
    <errorDisplayField>SettingKey__c</errorDisplayField>
    <errorMessage>シードキーは作成後に変更できません。</errorMessage>
</ValidationRule>
