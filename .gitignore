# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json
.tmp-retrieve/
**/_retrieved/

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Local retrieve artifacts / spreadsheets
*.zip
*.xlsx

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Local Cursor / deploy scratch
.cursor/
.deploy-skip/

# Local deploy / retrieve / investigation scratch (do not publish)
.tmp*/
.tmp-*
.tmp-*/*
deploy-*.json
deploy-*.txt
deploy-*.log
deploy-*.err
org-retrieve-*/
retrieved-*/
investigation-*/
coverage/
patches/
docs/tickets/
docs/デプロイ仕様_*.md
